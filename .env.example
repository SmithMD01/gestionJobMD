# Copy to .env. Keep passwords out of Git.
POSTGRES_DB=gestion_job
POSTGRES_USER=gestion_job
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://gestion_job:change-this-local-password@127.0.0.1:5433/gestion_job
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CALENDAR_CLIENT_ID=your-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-oauth-client-secret
# Shared AES-256 key for Google and Microsoft calendar refresh tokens.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Must exactly match the callback URI configured in Google Cloud. Defaults to BETTER_AUTH_URL/api/calendar/google/callback.
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
MICROSOFT_CALENDAR_CLIENT_ID=your-entra-application-client-id
MICROSOFT_CALENDAR_CLIENT_SECRET=your-entra-client-secret
# Use the Directory (tenant) ID for your organization's account; common/organizations are also supported.
MICROSOFT_CALENDAR_TENANT_ID=your-directory-tenant-id
# Must exactly match the Web redirect URI configured in Microsoft Entra.
# MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/microsoft/callback
