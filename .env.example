# Copy to .env. Keep passwords out of Git.
POSTGRES_DB=gestion_job
POSTGRES_USER=gestion_job
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://gestion_job:change-this-local-password@127.0.0.1:5433/gestion_job
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
